# ─────────────────────────────────────────────────────────────
# Zach's BS Hub — environment configuration
# Copy to server/.env for local dev. On Railway, set these as
# service variables instead of committing a .env file.
# ─────────────────────────────────────────────────────────────

# Server
PORT=4000
NODE_ENV=development

# Absolute or relative path to the SQLite database file.
# On Railway, point this at a mounted volume, e.g. /data/hub.sqlite
DATABASE_PATH=./data/hub.sqlite

# Where uploaded tile-background images are stored. Defaults next to the
# database (so they persist on the same volume). e.g. /data/uploads
# UPLOADS_PATH=

# Path to the built client (served in production). Default resolves
# to ../../client/dist relative to the compiled server.
# CLIENT_DIST=

# Auth — admin account is seeded on first boot from these values.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-now
JWT_SECRET=replace-with-a-long-random-string
# Token lifetime, e.g. 12h, 7d
JWT_EXPIRES_IN=12h

# CORS origin for split deployments (frontend on a different domain).
# Leave blank when the backend serves the client (single service).
# CORS_ORIGIN=https://your-domain.com

# ─────────────────────────────────────────────────────────────
# Module toggles — set to "false" to disable a module entirely.
# Disabled modules are not mounted on the API and not advertised
# to the frontend, which hides them gracefully. All default ON.
# ─────────────────────────────────────────────────────────────
# The tile dashboard is the primary content system.
MODULE_TILES=true
MODULE_ANALYTICS=true

# Legacy section modules — superseded by tiles, off by default.
MODULE_CONTACT=false
MODULE_LINKS=false
MODULE_PROJECTS=false
MODULE_ABOUT=false
MODULE_HEALTH=false

# Status checker: how often (ms) to ping service tiles (web + Minecraft).
HEALTH_INTERVAL_MS=60000
